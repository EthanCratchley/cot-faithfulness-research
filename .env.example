# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and must never be committed.

# Step 1 API capability probes — probes/*.py read this directly.
# Re-running all seven probes costs about $2.
OPENROUTER_API_KEY=REPLACE_ME

# The Biasing Features judge — harness/judge.py constructs anthropic.Anthropic()
# with no arguments, so the SDK picks this up from the environment.
# The study's reported verdicts were produced with claude-opus-5.
ANTHROPIC_API_KEY=REPLACE_ME

# Optional. Only needed to download gated weights.
# HF_TOKEN=REPLACE_ME

# Not used by any code here: GPU rental was arranged outside the repo, and the
# generation scripts run on the pod itself.
